# Template for the local .env used by docker compose. Copy to .env and fill in.
#   cp .env.example .env
# The real .env is gitignored so your key is never committed.

# 'stub' (no key needed) or 'openai' (real Spring AI generation + semantic search).
GENERATION_PROVIDER=stub

# Your OpenAI API key — required only when GENERATION_PROVIDER=openai.
OPENAI_API_KEY=
